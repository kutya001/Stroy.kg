{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the platform (consumer, developer, supplier)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["consumer", "developer", "supplier", "admin"] },
        "companyName": { "type": "string", "description": "Company name if applicable" },
        "inn": { "type": "string", "description": "Tax Identification Number (ИНН)" },
        "dateOfBirth": { "type": "string", "description": "Date of birth (YYYY-MM-DD)" },
        "address": { "type": "string" },
        "housingType": { "type": "string" },
        "documents": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "url": { "type": "string" } } } },
        "projects": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "url": { "type": "string" } } } },
        "certificates": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "url": { "type": "string" } } } },
        "categories": { "type": "array", "items": { "type": "string" } },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "subscription": { "type": "string", "enum": ["free", "premium", "pro"] },
        "onboardingCompleted": { "type": "boolean" },
        "region": { "type": "string" },
        "rating": { "type": "number", "description": "User rating" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "role", "createdAt", "onboardingCompleted"]
    },
    "Request": {
      "title": "Request",
      "description": "A request for materials, services, or equipment",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "description": "UID of the user who created the request" },
        "category": { "type": "string", "enum": ["materials", "services", "equipment"] },
        "title": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "budget": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "category", "title", "description", "status", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A chat conversation between users",
      "type": "object",
      "properties": {
        "participants": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Array of user UIDs"
        },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId", "text", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles"
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/Request" },
      "description": "Stores all platform requests"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Stores chat sessions"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Stores messages within a chat"
    }
  }
}
